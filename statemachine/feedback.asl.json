{
  "Comment": "Mortgage application reviewer workflow (S3 -> extraction -> reasoning -> credit bureau stub -> decision -> persist -> SES notify)",
  "StartAt": "ExtractAndRedact",
  "States": {
    "ExtractAndRedact": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ValidateRedactFunctionArn}",
        "Payload.$": "$"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "OutputPath": "$.Payload",
      "Next": "ProcessApplications"
    },
    "ProcessApplications": {
      "Type": "Map",
      "ItemsPath": "$.records",
      "MaxConcurrency": 10,
      "Iterator": {
        "StartAt": "ReasonAndRecommend",
        "States": {
          "ReasonAndRecommend": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${ClassifyDraftFunctionArn}",
              "Payload.$": "$"
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ],
            "OutputPath": "$.Payload",
            "Next": "FetchCreditScore"
          },
          "FetchCreditScore": {
            "Type": "Task",
            "Comment": "Represents the Bedrock Agent calling external credit bureau via AgentCore Gateway (stubbed as Lambda).",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${CreditBureauStubFunctionArn}",
              "Payload": {
                "ssn_last4.$": "$.entities.ssn_last4",
                "name.$": "$.entities.name"
              }
            },
            "ResultPath": "$.credit_bureau",
            "Next": "DecideStatus"
          },
          "DecideStatus": {
            "Type": "Pass",
            "Parameters": {
              "application_id.$": "$.application_id",
              "entities.$": "$.entities",
              "extracted_text.$": "$.extracted_text",
              "claimed.$": "$.claimed",
              "flags.$": "$.flags",
              "recommendation.$": "$.recommendation",
              "explanation.$": "$.explanation",
              "confidence.$": "$.confidence",
              "applicant_email.$": "$.applicant_email",
              "credit_score.$": "$.credit_bureau.Payload.credit_score",
              "credit_queried_at.$": "$.credit_bureau.Payload.queried_at"
            },
            "Next": "NeedsHumanReview?"
          },
          "NeedsHumanReview?": {
            "Type": "Choice",
            "Choices": [
              {
                "Or": [
                  {
                    "Variable": "$.recommendation",
                    "StringEquals": "HUMAN_REVIEW"
                  },
                  {
                    "Variable": "$.confidence",
                    "NumericLessThan": ${ConfidenceThreshold}
                  },
                  {
                    "Variable": "$.credit_score",
                    "NumericLessThan": 580
                  }
                ],
                "Next": "CreateHumanReview"
              }
            ],
            "Default": "PersistAutoResult"
          },
          "PersistAutoResult": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${PersistResultFunctionArn}",
              "Payload": {
                "application_id.$": "$.application_id",
                "recommendation.$": "$.recommendation",
                "confidence.$": "$.confidence",
                "credit_score.$": "$.credit_score",
                "flags.$": "$.flags",
                "explanation.$": "$.explanation",
                "applicant_email.$": "$.applicant_email",
                "final_status": "AUTO_COMPLETED",
                "review_id": null
              }
            },
            "OutputPath": "$.Payload",
            "Next": "NotifyApplicant"
          },
          "CreateHumanReview": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
            "TimeoutSeconds": 604800,
            "Parameters": {
              "FunctionName": "${CreateReviewFunctionArn}",
              "Payload": {
                "task_token.$": "$$.Task.Token",
                "feedback.$": "$"
              }
            },
            "ResultPath": "$.review_result",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ],
            "Next": "PersistReviewedResult"
          },
          "PersistReviewedResult": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${PersistResultFunctionArn}",
              "Payload": {
                "application_id.$": "$.application_id",
                "recommendation.$": "$.recommendation",
                "confidence.$": "$.confidence",
                "credit_score.$": "$.credit_score",
                "flags.$": "$.flags",
                "explanation.$": "$.explanation",
                "applicant_email.$": "$.applicant_email",
                "review_id.$": "$.review_result.review_id",
                "final_status.$": "$.review_result.final_status",
                "reviewed_at.$": "$.review_result.reviewed_at",
                "reviewer.$": "$.review_result.reviewer",
                "notes.$": "$.review_result.notes"
              }
            },
            "OutputPath": "$.Payload",
            "Next": "NotifyApplicant"
          },
          "NotifyApplicant": {
            "Type": "Task",
            "Comment": "Send an SES email notification to the applicant with their status.",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${NotifyApplicantFunctionArn}",
              "Payload.$": "$"
            },
            "OutputPath": "$.Payload",
            "End": true
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailWorkflow"
        }
      ],
      "Next": "Success"
    },
    "FailWorkflow": {
      "Type": "Fail",
      "Error": "MortgageReviewPipelineFailed",
      "Cause": "Extraction, reasoning, persistence, or notification error"
    },
    "Success": {
      "Type": "Succeed"
    }
  }
}
